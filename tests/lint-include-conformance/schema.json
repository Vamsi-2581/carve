{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markup-carve.dev/schemas/lint-include-conformance.json",
  "title": "Carve lint include-conformance vectors",
  "description": "Cross-engine vectors for CARVE-P6-001 I16: what a linter reports when it expands includes.",
  "type": "object",
  "required": ["version", "sourcePath", "vectors"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "sourcePath": {
      "type": "string",
      "description": "Identity of the top-level document, passed to the expansion and used as the file of every top-level finding."
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "resolver", "entry", "files", "expected"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "description": { "type": "string" },
          "resolver": {
            "enum": ["virtual", "none"],
            "description": "'virtual' serves `files` by the directive path as written, returning plain source; 'none' lints with no root and no resolver."
          },
          "entry": { "type": "string", "description": "The top-level document source." },
          "files": {
            "type": "object",
            "description": "The in-memory files, keyed by directive path.",
            "additionalProperties": { "type": "string" }
          },
          "expected": {
            "type": "object",
            "required": ["findings"],
            "additionalProperties": false,
            "properties": {
              "findings": {
                "type": "array",
                "description": "Every lint finding, compared as a list sorted by file, line, column and rule.",
                "items": {
                  "type": "object",
                  "required": ["rule", "file", "line", "column"],
                  "additionalProperties": false,
                  "properties": {
                    "rule": { "type": "string" },
                    "file": { "type": "string" },
                    "line": { "type": "integer", "minimum": 1 },
                    "column": { "type": "integer", "minimum": 1 },
                    "includedBy": {
                      "type": "array",
                      "minItems": 1,
                      "description": "The include chain, top-level directive first. Absent for a finding in the top-level document.",
                      "items": {
                        "type": "object",
                        "required": ["file", "line", "column"],
                        "additionalProperties": false,
                        "properties": {
                          "file": { "type": "string" },
                          "line": { "type": "integer", "minimum": 1 },
                          "column": { "type": "integer", "minimum": 1 }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
